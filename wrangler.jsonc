{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuniko",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./artifacts/yuniko-app/dist/public/server/server.js",
  "assets": {
    "directory": "./artifacts/yuniko-app/dist/public/client"
  },
  "observability": {
    "enabled": true
  }
}
